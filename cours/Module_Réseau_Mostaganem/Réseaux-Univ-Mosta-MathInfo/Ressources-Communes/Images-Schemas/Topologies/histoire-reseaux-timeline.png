  <text x="400" y="40" text-anchor="middle" font-family="Arial,sans-serif" font-size="18" font-weight="bold" fill="#1e293b">Histoire des Réseaux</text>
  <text x="400" y="62" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#94a3b8">Schéma pédagogique — Module Réseaux — Dr. BELACEL Madani</text>
  <line x1="60" y1="160" x2="740" y2="160" stroke="#94a3b8" stroke-width="3"/>
  <circle cx="100" cy="160" r="12" fill="#3b82f6" stroke="#fff" stroke-width="3"/><text x="100" y="195" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" font-weight="bold" fill="#3b82f6">1960</text><text x="100" y="210" text-anchor="middle" font-family="Arial,sans-serif" font-size="8" fill="#475569">ARPANET</text>
  <circle cx="200" cy="160" r="12" fill="#2563eb" stroke="#fff" stroke-width="3"/><text x="200" y="195" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" font-weight="bold" fill="#2563eb">1970</text><text x="200" y="210" text-anchor="middle" font-family="Arial,sans-serif" font-size="8" fill="#475569">Ethernet</text>
  <circle cx="300" cy="160" r="12" fill="#7c3aed" stroke="#fff" stroke-width="3"/><text x="300" y="195" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" font-weight="bold" fill="#7c3aed">1980</text><text x="300" y="210" text-anchor="middle" font-family="Arial,sans-serif" font-size="8" fill="#475569">TCP/IP</text>
  <circle cx="400" cy="160" r="12" fill="#f59e0b" stroke="#fff" stroke-width="3"/><text x="400" y="195" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" font-weight="bold" fill="#f59e0b">1990</text><text x="400" y="210" text-anchor="middle" font-family="Arial,sans-serif" font-size="8" fill="#475569">Web (1991)</text>
  <circle cx="500" cy="160" r="12" fill="#22c55e" stroke="#fff" stroke-width="3"/><text x="500" y="195" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" font-weight="bold" fill="#22c55e">2000</text><text x="500" y="210" text-anchor="middle" font-family="Arial,sans-serif" font-size="8" fill="#475569">IPv6, Wi-Fi</text>
  <circle cx="600" cy="160" r="12" fill="#ef4444" stroke="#fff" stroke-width="3"/><text x="600" y="195" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" font-weight="bold" fill="#ef4444">2010</text><text x="600" y="210" text-anchor="middle" font-family="Arial,sans-serif" font-size="8" fill="#475569">Cloud, SDN</text>
  <circle cx="700" cy="160" r="12" fill="#a855f7" stroke="#fff" stroke-width="3"/><text x="700" y="195" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" font-weight="bold" fill="#a855f7">2020+</text><text x="700" y="210" text-anchor="middle" font-family="Arial,sans-serif" font-size="8" fill="#475569">Quantum, IA</text>
