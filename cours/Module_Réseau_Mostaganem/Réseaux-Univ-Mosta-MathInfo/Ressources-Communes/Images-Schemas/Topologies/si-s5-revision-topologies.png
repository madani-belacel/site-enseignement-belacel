  <rect x="50" y="85" width="700" height="35" rx="6" fill="#1e293b"/><text x="400" y="108" text-anchor="middle" font-family="Arial,sans-serif" font-size="14" fill="#fff" font-weight="bold">SI S5 — Révision des Topologies de Réseau</text>
  <circle cx="160" cy="170" r="30" fill="#e0e7ff" stroke="#6366f1" stroke-width="2"/>
