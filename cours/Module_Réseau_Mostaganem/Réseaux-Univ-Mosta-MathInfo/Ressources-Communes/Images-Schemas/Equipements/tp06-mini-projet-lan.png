  <text x="400" y="225" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#bfdbfe">24 ports Gigabit</text>
  <line x1="300" y1="230" x2="200" y2="260" stroke="#64748b" stroke-width="2"/><line x1="400" y1="230" x2="400" y2="260" stroke="#64748b" stroke-width="2"/><line x1="500" y1="230" x2="600" y2="260" stroke="#64748b" stroke-width="2"/>
