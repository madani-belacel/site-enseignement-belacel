<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <rect width="800" height="500" fill="#f8fafc" rx="8"/>
  <rect x="10" y="10" width="780" height="480" fill="none" stroke="#e2e8f0" stroke-width="2" rx="4" stroke-dasharray="8,4"/>
  <text x="400" y="40" text-anchor="middle" font-family="Arial,sans-serif" font-size="18" font-weight="bold" fill="#1e293b">Couche Physique — Vue d'Ensemble</text>
  <text x="400" y="62" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#94a3b8">Schéma pédagogique — Module Réseaux — Dr. BELACEL Madani</text>
  <rect x="50" y="95" width="700" height="40" rx="6" fill="#1e293b"/>
  <text x="400" y="120" text-anchor="middle" font-family="Arial,sans-serif" font-size="14" fill="#fff" font-weight="bold">Couche Physique — Transmission des Bits</text>
  <rect x="50" y="155" width="200" height="130" rx="8" fill="#e0e7ff" stroke="#6366f1" stroke-width="2"/>
  <text x="150" y="178" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" font-weight="bold" fill="#3730a3">Supports Guidés</text>
  <text x="65" y="200" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Paire torsadée (RJ45)</text>
  <text x="65" y="218" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Câble coaxial</text>
  <text x="65" y="236" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Fibre optique</text>
  <text x="65" y="254" font-family="Arial,sans-serif" font-size="10" fill="#475569">  (monomode / multimode)</text>
  <rect x="290" y="155" width="220" height="130" rx="8" fill="#dcfce7" stroke="#22c55e" stroke-width="2"/>
  <text x="400" y="178" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" font-weight="bold" fill="#166534">Supports non Guidés</text>
  <text x="305" y="200" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Ondes radio (Wi-Fi)</text>
  <text x="305" y="218" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Infrarouge</text>
  <text x="305" y="236" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Micro-ondes</text>
  <text x="305" y="254" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Satellite</text>
  <rect x="550" y="155" width="200" height="130" rx="8" fill="#fef3c7" stroke="#f59e0b" stroke-width="2"/>
  <text x="650" y="178" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" font-weight="bold" fill="#92400e">Topologies</text>
  <text x="565" y="200" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Bus / Étoile / Anneau</text>
  <text x="565" y="218" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Maillée / Hybride</text>
  <text x="565" y="236" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Normes: RS-232</text>
  <text x="565" y="254" font-family="Arial,sans-serif" font-size="10" fill="#475569">  V.24, X.21, USB</text>
  <rect x="80" y="310" width="640" height="90" rx="8" fill="#fff" stroke="#cbd5e1" stroke-width="1"/>
  <text x="400" y="335" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" font-weight="bold" fill="#475569">Caractéristiques de la Couche Physique</text>
  <text x="95" y="358" font-family="Arial,sans-serif" font-size="10" fill="#64748b">• Mécanique: connecteurs, broches, interfaces</text>
  <text x="95" y="376" font-family="Arial,sans-serif" font-size="10" fill="#64748b">• Électrique: niveaux de tension, débit binaire, codage</text>
  <text x="95" y="394" font-family="Arial,sans-serif" font-size="10" fill="#64748b">• Fonctionnelle: définition des fonctions de chaque broche</text>
</svg>