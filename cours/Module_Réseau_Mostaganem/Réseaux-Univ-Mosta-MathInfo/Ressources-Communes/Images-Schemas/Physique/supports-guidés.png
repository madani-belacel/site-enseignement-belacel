  <text x="60" y="340" font-family="Arial,sans-serif" font-size="10" fill="#475569">Immunité EMI</text><text x="250" y="340" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#3b82f6">Faible</text><text x="380" y="340" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#22c55e">Moyenne</text><text x="510" y="340" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#f59e0b">Totale</text>
  <text x="60" y="365" font-family="Arial,sans-serif" font-size="10" fill="#475569">Installation</text><text x="250" y="365" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#3b82f6">Facile</text><text x="380" y="365" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#22c55e">Moyenne</text><text x="510" y="365" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#f59e0b">Difficile</text>
