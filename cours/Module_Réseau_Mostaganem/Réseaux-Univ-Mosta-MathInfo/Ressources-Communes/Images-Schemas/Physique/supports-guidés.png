  <text x="400" y="115" text-anchor="middle" font-family="Arial,sans-serif" font-size="14" fill="#fff" font-weight="bold">Synthèse des Supports Guidés</text>
  <rect x="50" y="150" width="220" height="40" rx="4" fill="#3b82f6"/><text x="160" y="175" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff" font-weight="bold">Paire Torsadée</text>
  <rect x="290" y="150" width="220" height="40" rx="4" fill="#22c55e"/><text x="400" y="175" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff" font-weight="bold">Coaxial</text>
  <rect x="530" y="150" width="220" height="40" rx="4" fill="#f59e0b"/><text x="640" y="175" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff" font-weight="bold">Fibre Optique</text>
  <rect x="50" y="210" width="700" height="200" rx="8" fill="#fff" stroke="#cbd5e1" stroke-width="1"/>
  <text x="60" y="235" font-family="Arial,sans-serif" font-size="11" font-weight="bold" fill="#475569">Critère / Support</text>
  <rect x="190" y="222" width="120" height="22" rx="3" fill="#e0e7ff"/><text x="250" y="237" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#3730a3">Paire Torsadée</text>
  <rect x="320" y="222" width="120" height="22" rx="3" fill="#dcfce7"/><text x="380" y="237" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#166534">Coaxial</text>
  <rect x="450" y="222" width="120" height="22" rx="3" fill="#fef3c7"/><text x="510" y="237" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#92400e">Fibre Optique</text>
  <text x="60" y="265" font-family="Arial,sans-serif" font-size="10" fill="#475569">Débit max</text><text x="250" y="265" text-anchor="middle" font-family="monospace" font-size="10" fill="#3b82f6">10 Gbps</text><text x="380" y="265" text-anchor="middle" font-family="monospace" font-size="10" fill="#22c55e">1 Gbps</text><text x="510" y="265" text-anchor="middle" font-family="monospace" font-size="10" fill="#f59e0b">400 Gbps+</text>
  <text x="60" y="290" font-family="Arial,sans-serif" font-size="10" fill="#475569">Distance max</text><text x="250" y="290" text-anchor="middle" font-family="monospace" font-size="10" fill="#3b82f6">100 m</text><text x="380" y="290" text-anchor="middle" font-family="monospace" font-size="10" fill="#22c55e">500 m</text><text x="510" y="290" text-anchor="middle" font-family="monospace" font-size="10" fill="#f59e0b">40 km+</text>
