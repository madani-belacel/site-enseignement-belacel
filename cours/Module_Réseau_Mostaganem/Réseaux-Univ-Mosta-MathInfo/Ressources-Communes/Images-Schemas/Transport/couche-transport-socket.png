<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <rect width="800" height="500" fill="#f8fafc" rx="8"/>
  <rect x="10" y="10" width="780" height="480" fill="none" stroke="#e2e8f0" stroke-width="2" rx="4" stroke-dasharray="8,4"/>
  <text x="400" y="40" text-anchor="middle" font-family="Arial,sans-serif" font-size="18" font-weight="bold" fill="#1e293b">Couche Transport — Socket</text>
  <text x="400" y="62" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#94a3b8">Schéma pédagogique — Module Réseaux — Dr. BELACEL Madani</text>
  <rect x="50" y="100" width="320" height="130" rx="8" fill="#e0e7ff" stroke="#6366f1" stroke-width="2"/>
  <text x="210" y="125" text-anchor="middle" font-family="Arial,sans-serif" font-size="14" font-weight="bold" fill="#3730a3">TCP (Transmission Control)</text>
  <text x="65" y="150" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Orienté connexion (3-way handshake)</text>
  <text x="65" y="168" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Fiable : ACK, retransmission</text>
  <text x="65" y="186" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Contrôle de flux (window)</text>
  <text x="65" y="204" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Contrôle de congestion</text>
  <text x="65" y="222" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Utilisé par: HTTP, FTP, SMTP, SSH</text>
  <rect x="430" y="100" width="320" height="130" rx="8" fill="#dcfce7" stroke="#22c55e" stroke-width="2"/>
  <text x="590" y="125" text-anchor="middle" font-family="Arial,sans-serif" font-size="14" font-weight="bold" fill="#166534">UDP (User Datagram)</text>
  <text x="445" y="150" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Non orienté connexion</text>
  <text x="445" y="168" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Pas fiable (best-effort)</text>
  <text x="445" y="186" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Faible latence</text>
  <text x="445" y="204" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Pas de contrôle de flux</text>
  <text x="445" y="222" font-family="Arial,sans-serif" font-size="10" fill="#475569">• Utilisé par: DNS, VoIP, Streaming</text>
  <rect x="150" y="260" width="500" height="80" rx="8" fill="#fff" stroke="#cbd5e1" stroke-width="1"/>
  <text x="400" y="283" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" font-weight="bold" fill="#475569">Socket = (IP_source, Port_source, IP_dest, Port_dest, Protocole)</text>
  <text x="400" y="310" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#64748b">Exemple: (192.168.1.10:54321, 93.184.216.34:80, TCP)</text>
  <text x="400" y="330" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#64748b">Ports: 0-1023 (système) | 1024-49151 (enregistrés) | 49152-65535 (dynamiques)</text>
</svg>