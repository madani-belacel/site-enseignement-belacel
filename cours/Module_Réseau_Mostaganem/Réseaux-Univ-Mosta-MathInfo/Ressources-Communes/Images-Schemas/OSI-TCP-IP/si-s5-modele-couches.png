<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <rect width="800" height="500" fill="#f8fafc" rx="8"/>
  <rect x="10" y="10" width="780" height="480" fill="none" stroke="#e2e8f0" stroke-width="2" rx="4" stroke-dasharray="8,4"/>
  <text x="400" y="40" text-anchor="middle" font-family="Arial,sans-serif" font-size="18" font-weight="bold" fill="#1e293b">SI S5 — Modèle en Couches</text>
  <text x="400" y="62" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#94a3b8">Schéma pédagogique — Module Réseaux — Dr. BELACEL Madani</text>
  <rect x="30" y="100" width="740" height="35" rx="6" fill="#3b82f6"/><text x="55" y="123" font-family="Arial,sans-serif" font-size="13" fill="#fff" font-weight="bold">Couches Hautes</text><text x="450" y="123" font-family="Arial,sans-serif" font-size="11" fill="#bfdbfe">(Session, Présentation, Application)</text>
  <rect x="30" y="145" width="740" height="35" rx="6" fill="#7c3aed"/><text x="55" y="168" font-family="Arial,sans-serif" font-size="13" fill="#fff" font-weight="bold">Couche Transport</text><text x="450" y="168" font-family="Arial,sans-serif" font-size="11" fill="#ddd6fe">(TCP, UDP)</text>
  <rect x="30" y="190" width="740" height="35" rx="6" fill="#f59e0b"/><text x="55" y="213" font-family="Arial,sans-serif" font-size="13" fill="#fff" font-weight="bold">Couche Réseau</text><text x="450" y="213" font-family="Arial,sans-serif" font-size="11" fill="#fef3c7">(IPv4, IPv6, Routage)</text>
  <rect x="30" y="235" width="740" height="35" rx="6" fill="#ef4444"/><text x="55" y="258" font-family="Arial,sans-serif" font-size="13" fill="#fff" font-weight="bold">Couche Liaison de Données</text><text x="450" y="258" font-family="Arial,sans-serif" font-size="11" fill="#fca5a5">(Ethernet, MAC, VLAN)</text>
  <rect x="30" y="280" width="740" height="35" rx="6" fill="#991b1b"/><text x="55" y="303" font-family="Arial,sans-serif" font-size="13" fill="#fff" font-weight="bold">Couche Physique</text><text x="450" y="303" font-family="Arial,sans-serif" font-size="11" fill="#fca5a5">(Support, Signal, Topologie)</text>
  <rect x="100" y="340" width="600" height="90" rx="8" fill="#fff" stroke="#cbd5e1" stroke-width="1"/>
  <text x="400" y="363" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" font-weight="bold" fill="#475569">Principe d'encapsulation</text>
  <text x="400" y="383" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#64748b">Données → Segment → Paquet → Trame → Bits</text>
  <text x="400" y="403" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#64748b">Chaque couche ajoute son en-tête (header) avant de transmettre à la couche inférieure</text>
  <text x="400" y="423" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#64748b">SI S5: focus sur les couches 2 (Liaison) et 3 (Réseau)</text>
</svg>