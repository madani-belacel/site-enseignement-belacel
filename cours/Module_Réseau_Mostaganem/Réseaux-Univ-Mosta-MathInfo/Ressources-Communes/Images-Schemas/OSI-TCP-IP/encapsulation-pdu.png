<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <rect width="800" height="500" fill="#f8fafc" rx="8"/>
  <rect x="10" y="10" width="780" height="480" fill="none" stroke="#e2e8f0" stroke-width="2" rx="4" stroke-dasharray="8,4"/>
  <text x="400" y="40" text-anchor="middle" font-family="Arial,sans-serif" font-size="18" font-weight="bold" fill="#1e293b">Encapsulation — PDU par couche</text>
  <text x="400" y="62" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#94a3b8">Schéma pédagogique — Module Réseaux — Dr. BELACEL Madani</text>
  <rect x="250" y="140" width="300" height="40" rx="6" fill="#3b82f6"/><text x="400" y="165" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#fff">Données (Application)</text>
  <rect x="200" y="190" width="400" height="40" rx="6" fill="#2563eb"/><text x="400" y="215" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#fff">Segment (Transport) — TCP/UDP</text>
  <rect x="150" y="240" width="500" height="40" rx="6" fill="#1d4ed8"/><text x="400" y="265" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#fff">Paquet (Réseau) — IP</text>
  <rect x="100" y="290" width="600" height="40" rx="6" fill="#ef4444"/><text x="400" y="315" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#fff">Trame (Liaison) — Ethernet</text>
  <rect x="50" y="340" width="700" height="40" rx="6" fill="#991b1b"/><text x="400" y="365" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#fff">Bits (Physique)</text>
</svg>