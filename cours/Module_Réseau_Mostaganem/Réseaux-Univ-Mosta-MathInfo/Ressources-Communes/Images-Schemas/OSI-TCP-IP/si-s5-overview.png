<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <rect width="800" height="500" fill="#f8fafc" rx="8"/>
  <rect x="10" y="10" width="780" height="480" fill="none" stroke="#e2e8f0" stroke-width="2" rx="4" stroke-dasharray="8,4"/>
  <text x="400" y="40" text-anchor="middle" font-family="Arial,sans-serif" font-size="18" font-weight="bold" fill="#1e293b">SI S5 — Vue d'Ensemble du Module</text>
  <text x="400" y="62" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#94a3b8">Schéma pédagogique — Module Réseaux — Dr. BELACEL Madani</text>
  <rect x="50" y="85" width="700" height="35" rx="6" fill="#1e293b"/><text x="400" y="108" text-anchor="middle" font-family="Arial,sans-serif" font-size="14" fill="#fff" font-weight="bold">Module Réseaux — SI S5 — Plan du Cours</text>
  <rect x="50" y="130" width="220" height="55" rx="6" fill="#ef4444"/><text x="160" y="152" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff" font-weight="bold">Ch. 1 — Généralités</text><text x="160" y="172" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" fill="#fca5a5">Définitions, Historique</text>
  <rect x="290" y="130" width="220" height="55" rx="6" fill="#f59e0b"/><text x="400" y="152" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff" font-weight="bold">Ch. 2 — Modèle OSI</text><text x="400" y="172" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" fill="#fef3c7">7 couches, Encapsulation</text>
  <rect x="530" y="130" width="220" height="55" rx="6" fill="#3b82f6"/><text x="640" y="152" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff" font-weight="bold">Ch. 3 — Couche Physique</text><text x="640" y="172" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" fill="#bfdbfe">Supports, Topologies</text>
  <rect x="50" y="195" width="220" height="55" rx="6" fill="#7c3aed"/><text x="160" y="217" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff" font-weight="bold">Ch. 4 — Couche Liaison</text><text x="160" y="237" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" fill="#ddd6fe">Ethernet, VLAN, MAC</text>
  <rect x="290" y="195" width="220" height="55" rx="6" fill="#22c55e"/><text x="400" y="217" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff" font-weight="bold">Ch. 5 — Couche Réseau</text><text x="400" y="237" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" fill="#bbf7d0">IPv4/IPv6, Routage</text>
  <rect x="530" y="195" width="220" height="55" rx="6" fill="#ec4899"/><text x="640" y="217" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff" font-weight="bold">Ch. 6 — Transport</text><text x="640" y="237" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" fill="#fbcfe8">TCP, UDP, Socket</text>
  <rect x="50" y="260" width="220" height="55" rx="6" fill="#a855f7"/><text x="160" y="282" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff" font-weight="bold">Ch. 7 — Applications</text><text x="160" y="302" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" fill="#e9d5ff">HTTP, DNS, DHCP</text>
  <rect x="290" y="260" width="220" height="55" rx="6" fill="#14b8a6"/><text x="400" y="282" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff" font-weight="bold">Ch. 8 — Sécurité</text><text x="400" y="302" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" fill="#ccfbf1">DMZ, Pare-feu, VPN</text>
  <rect x="530" y="260" width="220" height="55" rx="6" fill="#f43f5e"/><text x="640" y="282" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff" font-weight="bold">TPs & Projets</text><text x="640" y="302" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" fill="#fecdd3">Packet Tracer, Mini-projet</text>
  <rect x="100" y="340" width="600" height="60" rx="8" fill="#fff" stroke="#cbd5e1" stroke-width="1"/>
  <text x="400" y="363" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#64748b">SI S5: 8 chapitres + 6 TPs + Mini-projet — Volume horaire: 45h (Cours: 21h, TD/TP: 24h)</text>
  <text x="400" y="385" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#64748b">Prérequis: Architecture des ordinateurs (S3/S4) | Évaluation: CC (40%) + Examen (60%)</text>
</svg>