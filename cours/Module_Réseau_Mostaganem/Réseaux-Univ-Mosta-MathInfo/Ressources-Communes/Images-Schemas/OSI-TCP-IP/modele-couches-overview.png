<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <rect width="800" height="500" fill="#f8fafc" rx="8"/>
  <rect x="10" y="10" width="780" height="480" fill="none" stroke="#e2e8f0" stroke-width="2" rx="4" stroke-dasharray="8,4"/>
  <text x="400" y="40" text-anchor="middle" font-family="Arial,sans-serif" font-size="18" font-weight="bold" fill="#1e293b">Modèle OSI et TCP/IP</text>
  <text x="400" y="62" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#94a3b8">Schéma pédagogique — Module Réseaux — Dr. BELACEL Madani</text>
  <rect x="30" y="125" width="200" height="30" rx="4" fill="#3b82f6"/><text x="130" y="145" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff">7 — Application</text>
  <rect x="30" y="158" width="200" height="30" rx="4" fill="#2563eb"/><text x="130" y="178" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff">6 — Présentation</text>
  <rect x="30" y="191" width="200" height="30" rx="4" fill="#1d4ed8"/><text x="130" y="211" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff">5 — Session</text>
  <rect x="30" y="224" width="200" height="30" rx="4" fill="#7c3aed"/><text x="130" y="244" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff">4 — Transport</text>
  <rect x="30" y="257" width="200" height="30" rx="4" fill="#f59e0b"/><text x="130" y="277" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff">3 — Réseau</text>
  <rect x="30" y="290" width="200" height="30" rx="4" fill="#ef4444"/><text x="130" y="310" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff">2 — Liaison</text>
  <rect x="30" y="323" width="200" height="30" rx="4" fill="#991b1b"/><text x="130" y="343" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#fff">1 — Physique</text>
  <rect x="280" y="145" width="220" height="60" rx="4" fill="#3b82f6"/><text x="390" y="170" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#fff">Application</text>
  <rect x="280" y="210" width="220" height="30" rx="4" fill="#7c3aed"/><text x="390" y="230" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#fff">Transport</text>
  <rect x="280" y="255" width="220" height="30" rx="4" fill="#f59e0b"/><text x="390" y="275" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#fff">Réseau (Internet)</text>
  <rect x="280" y="290" width="220" height="60" rx="4" fill="#ef4444"/><text x="390" y="315" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#fff">Accès Réseau</text>
