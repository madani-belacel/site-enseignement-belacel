<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <rect width="800" height="500" fill="#f8fafc" rx="8"/>
  <rect x="10" y="10" width="780" height="480" fill="none" stroke="#e2e8f0" stroke-width="2" rx="4" stroke-dasharray="8,4"/>
  <text x="400" y="40" text-anchor="middle" font-family="Arial,sans-serif" font-size="18" font-weight="bold" fill="#1e293b">Trame Ethernet IEEE 802.3</text>
  <text x="400" y="62" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#94a3b8">Schéma pédagogique — Module Réseaux — Dr. BELACEL Madani</text>
  <rect x="50" y="100" width="700" height="40" rx="6" fill="#f0f4f8" stroke="#cbd5e1" stroke-width="1"/>
  <text x="400" y="125" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" font-weight="bold" fill="#475569">Format de trame Ethernet IEEE 802.3</text>
  <rect x="50" y="140" width="90" height="25" rx="3" fill="#3b82f6"/><text x="95" y="157" text-anchor="middle" font-family="monospace" font-size="9" fill="#fff">Préambule</text>
  <rect x="145" y="140" width="30" height="25" rx="3" fill="#2563eb"/><text x="160" y="157" text-anchor="middle" font-family="monospace" font-size="8" fill="#fff">SFD</text>
  <rect x="180" y="140" width="70" height="25" rx="3" fill="#1d4ed8"/><text x="215" y="157" text-anchor="middle" font-family="monospace" font-size="9" fill="#fff">MAC dst</text>
  <rect x="255" y="140" width="70" height="25" rx="3" fill="#1d4ed8"/><text x="290" y="157" text-anchor="middle" font-family="monospace" font-size="9" fill="#fff">MAC src</text>
  <rect x="330" y="140" width="40" height="25" rx="3" fill="#7c3aed"/><text x="350" y="157" text-anchor="middle" font-family="monospace" font-size="8" fill="#fff">Type</text>
  <rect x="375" y="140" width="220" height="25" rx="3" fill="#22c55e"/><text x="485" y="157" text-anchor="middle" font-family="monospace" font-size="9" fill="#fff">Données (46-1500 octets)</text>
  <rect x="600" y="140" width="40" height="25" rx="3" fill="#ef4444"/><text x="620" y="157" text-anchor="middle" font-family="monospace" font-size="9" fill="#fff">FCS</text>
  <rect x="50" y="185" width="700" height="200" rx="8" fill="#fff" stroke="#cbd5e1" stroke-width="1"/>
  <text x="70" y="208" font-family="Arial,sans-serif" font-size="11" font-weight="bold" fill="#475569">Détail des champs</text>
</svg>