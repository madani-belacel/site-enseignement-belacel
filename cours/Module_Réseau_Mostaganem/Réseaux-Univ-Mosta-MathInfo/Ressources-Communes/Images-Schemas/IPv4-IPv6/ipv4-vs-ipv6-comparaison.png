<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <rect width="800" height="500" fill="#f8fafc" rx="8"/>
  <rect x="10" y="10" width="780" height="480" fill="none" stroke="#e2e8f0" stroke-width="2" rx="4" stroke-dasharray="8,4"/>
  <text x="400" y="40" text-anchor="middle" font-family="Arial,sans-serif" font-size="18" font-weight="bold" fill="#1e293b">IPv4 vs IPv6 — Comparaison</text>
  <text x="400" y="62" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#94a3b8">Schéma pédagogique — Module Réseaux — Dr. BELACEL Madani</text>
  <rect x="50" y="95" width="330" height="200" rx="8" fill="#e0e7ff" stroke="#6366f1" stroke-width="2"/>
  <text x="215" y="120" text-anchor="middle" font-family="Arial,sans-serif" font-size="16" font-weight="bold" fill="#3730a3">IPv4</text>
  <text x="65" y="145" font-family="Arial,sans-serif" font-size="11" fill="#475569">• 32 bits (4 octets)</text>
  <text x="65" y="165" font-family="Arial,sans-serif" font-size="11" fill="#475569">• ~4.3 milliards d'adresses</text>
  <text x="65" y="185" font-family="Arial,sans-serif" font-size="11" fill="#475569">• Notation décimale pointée</text>
  <text x="65" y="205" font-family="Arial,sans-serif" font-size="11" fill="#475569">• NAT nécessaire</text>
  <text x="65" y="225" font-family="Arial,sans-serif" font-size="11" fill="#475569">• Pas de sécurité intégrée</text>
  <text x="65" y="245" font-family="Arial,sans-serif" font-size="11" fill="#475569">• Broadcast</text>
  <text x="65" y="265" font-family="Arial,sans-serif" font-size="11" fill="#475569">• En-tête variable (20-60 octets)</text>
  <text x="65" y="285" font-family="Arial,sans-serif" font-size="11" fill="#475569">• Ex: 192.168.1.1</text>
  <rect x="420" y="95" width="330" height="200" rx="8" fill="#dcfce7" stroke="#22c55e" stroke-width="2"/>
  <text x="585" y="120" text-anchor="middle" font-family="Arial,sans-serif" font-size="16" font-weight="bold" fill="#166534">IPv6</text>
  <text x="435" y="145" font-family="Arial,sans-serif" font-size="11" fill="#475569">• 128 bits (16 octets)</text>
  <text x="435" y="165" font-family="Arial,sans-serif" font-size="11" fill="#475569">• ~340 undécillions d'adresses</text>
  <text x="435" y="185" font-family="Arial,sans-serif" font-size="11" fill="#475569">• Notation hexadécimale (:) </text>
  <text x="435" y="205" font-family="Arial,sans-serif" font-size="11" fill="#475569">• Pas de NAT (adressage natif)</text>
  <text x="435" y="225" font-family="Arial,sans-serif" font-size="11" fill="#475569">• IPSec intégré</text>
  <text x="435" y="245" font-family="Arial,sans-serif" font-size="11" fill="#475569">• Multicast / Anycast</text>
  <text x="435" y="265" font-family="Arial,sans-serif" font-size="11" fill="#475569">• En-tête fixe (40 octets)</text>
  <text x="435" y="285" font-family="Arial,sans-serif" font-size="11" fill="#475569">• Ex: 2001:db8::1</text>
  <rect x="100" y="320" width="600" height="80" rx="8" fill="#fff" stroke="#cbd5e1" stroke-width="1"/>
  <text x="400" y="345" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" font-weight="bold" fill="#475569">Mécanismes de transition: Dual Stack | Tunneling (6to4, Teredo) | NAT64</text>
  <text x="400" y="370" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#64748b">IPv6 est obligatoire pour les nouveaux réseaux — recommandé depuis 2012 par l'IANA</text>
  <text x="400" y="390" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#64748b">TD pratique: calculer le nombre d'adresses IPv6 par rapport à IPv4</text>
</svg>