<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <rect width="800" height="500" fill="#f8fafc" rx="8"/>
  <rect x="10" y="10" width="780" height="480" fill="none" stroke="#e2e8f0" stroke-width="2" rx="4" stroke-dasharray="8,4"/>
  <text x="400" y="40" text-anchor="middle" font-family="Arial,sans-serif" font-size="18" font-weight="bold" fill="#1e293b">TP 03 — Routage Statique</text>
  <text x="400" y="62" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#94a3b8">Schéma pédagogique — Module Réseaux — Dr. BELACEL Madani</text>
  <rect x="50" y="95" width="220" height="160" rx="8" fill="#e0e7ff" stroke="#6366f1" stroke-width="2"/>
  <text x="160" y="120" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" font-weight="bold" fill="#3730a3">Réseau A</text>
  <text x="160" y="140" text-anchor="middle" font-family="monospace" font-size="10" fill="#6366f1">192.168.10.0/24</text>
  <rect x="100" y="160" width="50" height="30" rx="4" fill="#3b82f6"/><text x="125" y="179" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" fill="#fff">PC1</text>
  <rect x="170" y="160" width="50" height="30" rx="4" fill="#3b82f6"/><text x="195" y="179" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" fill="#fff">PC2</text>
  <rect x="100" y="210" width="120" height="30" rx="4" fill="#6366f1"/><text x="160" y="229" text-anchor="middle" font-family="monospace" font-size="9" fill="#fff">R1 (.1)</text>
  <rect x="290" y="145" width="220" height="60" rx="8" fill="#1e293b"/>
  <text x="400" y="170" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#fff">Réseau Intermédiaire</text>
  <text x="400" y="190" text-anchor="middle" font-family="monospace" font-size="9" fill="#94a3b8">10.0.0.0/30</text>
  <rect x="530" y="95" width="220" height="160" rx="8" fill="#dcfce7" stroke="#22c55e" stroke-width="2"/>
  <text x="640" y="120" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" font-weight="bold" fill="#166534">Réseau B</text>
  <text x="640" y="140" text-anchor="middle" font-family="monospace" font-size="10" fill="#22c55e">192.168.20.0/24</text>
  <rect x="580" y="160" width="50" height="30" rx="4" fill="#22c55e"/><text x="605" y="179" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" fill="#fff">PC3</text>
  <rect x="650" y="160" width="50" height="30" rx="4" fill="#22c55e"/><text x="675" y="179" text-anchor="middle" font-family="Arial,sans-serif" font-size="9" fill="#fff">PC4</text>
  <rect x="580" y="210" width="120" height="30" rx="4" fill="#22c55e"/><text x="640" y="229" text-anchor="middle" font-family="monospace" font-size="9" fill="#fff">R2 (.2)</text>
  <text x="400" y="300" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#64748b">Config R1: ip route 192.168.20.0 255.255.255.0 10.0.0.2</text>
  <text x="400" y="318" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#64748b">Config R2: ip route 192.168.10.0 255.255.255.0 10.0.0.1</text>
  <text x="400" y="345" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" fill="#64748b">TP Packet Tracer: simulation de 2 réseaux reliés par routeur + routes statiques</text>
</svg>